// Pioneer DDJ-FLX4 — runtime input profile (flat schema, parses with `Profile`).
//
// Addresses captured live against real hardware; see docs/devices/pioneer-ddj-flx4.md
// for the full protocol and the richer (deck-templated, pad-range, feedback) schema
// planned for a later pass. This file is what ships and is decoded today: input
// bindings only, both decks hand-expanded to concrete addresses.
//
// Deck channels: deck A = note 0x90 / CC 0xB0 / pads 0x97; deck B = 0x91 / 0xB1 / 0x99
// (deck B mirrors A with the channel nibble +1). Browser/mixer = channel 6 (0xB6).
//
// v1 limitations (deferred): hi-res knobs resolve at 7-bit (MSB only); the
// browse/load and pad-mode/feedback controls are not bound here yet.
// CFX (colour FX) knobs → Filter confirmed live; Pad FX 1 note addresses are
// inferred from the standard Pioneer N×0x10 pad-mode layout — MUST be verified
// live on the unit with the `ctl` harness before relying on them.
Profile(
    name: "Pioneer DDJ-FLX4",
    // Case-insensitive substring against the input port name.
    port_match: "ddj-flx4",
    // REQUIRED enable handshake: quiets the idle flood and unlocks the LEDs.
    init: [[0xF0, 0x00, 0x40, 0x05, 0x00, 0x00, 0x04, 0x05, 0x00, 0x50, 0x02, 0xF7]],
    inputs: [
        // ───────── Deck A (note 0x90, CC 0xB0, pads 0x97) ─────────
        InputBinding(status: 0x90, data1: 0x0B, target: Play(A)),
        InputBinding(status: 0x90, data1: 0x0C, target: CueMonitor(A)),
        // Headphone-cue (PFL) button under the channel strip (Mixxx `pfl`).
        InputBinding(status: 0x90, data1: 0x54, target: CueMonitor(A)),
        InputBinding(status: 0xB0, data1: 0x04, target: Trim(A),          hires: true),
        InputBinding(status: 0xB0, data1: 0x07, target: EqHigh(A),        hires: true),
        InputBinding(status: 0xB0, data1: 0x0B, target: EqMid(A),         hires: true),
        InputBinding(status: 0xB0, data1: 0x0F, target: EqLow(A),         hires: true),
        InputBinding(status: 0xB0, data1: 0x13, target: ChannelVolume(A), hires: true),
        InputBinding(status: 0xB0, data1: 0x00, target: Tempo(A),         hires: true),
        InputBinding(status: 0x90, data1: 0x36, target: JogTouch(A)),
        InputBinding(status: 0xB0, data1: 0x22, target: JogScratch(A),    rel: Some(Centre64)),
        InputBinding(status: 0xB0, data1: 0x21, target: JogBend(A),       rel: Some(Centre64)),
        // Loop / beat-sync cluster — notes captured live off the unit 2026-07-03.
        InputBinding(status: 0x90, data1: 0x10, target: LoopIn(A)),           // IN
        InputBinding(status: 0x90, data1: 0x11, target: LoopOut(A)),          // OUT
        InputBinding(status: 0x90, data1: 0x4D, target: LoopFourOrExit(A)),   // 4 BEAT/EXIT
        InputBinding(status: 0x90, data1: 0x51, target: LoopCallPrev(A)),     // CUE/LOOP CALL <
        InputBinding(status: 0x90, data1: 0x53, target: LoopCallNext(A)),     // CUE/LOOP CALL >
        InputBinding(status: 0x90, data1: 0x58, target: Sync(A)),             // BEAT SYNC
        InputBinding(status: 0x90, data1: 0x50, target: LoopReloop(A)),       // shift: ACTIVE
        InputBinding(status: 0x90, data1: 0x3E, target: LoopDelete(A)),       // shift: DEL
        InputBinding(status: 0x90, data1: 0x3D, target: LoopSave(A)),         // shift: MEMORY
        // Not yet bound (need engine work): IN ADJ 0x4C, OUT ADJ 0x4E (loop-point
        // nudge), TEMPO RANGE 0x60 (frontend cycle), MASTER long-press on SYNC.
        // hot-cue pads 0x00..0x07 — momentary (hold-to-play): press jumps to the cue,
        // release returns to the slip ghost when slip is on (plain jump when off)
        InputBinding(status: 0x97, data1: 0x00, target: HotCueHold(A, 0)),
        InputBinding(status: 0x97, data1: 0x01, target: HotCueHold(A, 1)),
        InputBinding(status: 0x97, data1: 0x02, target: HotCueHold(A, 2)),
        InputBinding(status: 0x97, data1: 0x03, target: HotCueHold(A, 3)),
        InputBinding(status: 0x97, data1: 0x04, target: HotCueHold(A, 4)),
        InputBinding(status: 0x97, data1: 0x05, target: HotCueHold(A, 5)),
        InputBinding(status: 0x97, data1: 0x06, target: HotCueHold(A, 6)),
        InputBinding(status: 0x97, data1: 0x07, target: HotCueHold(A, 7)),
        // sampler-mode pads repurposed for stems: top row mute 0..3, bottom row solo 0..3
        InputBinding(status: 0x97, data1: 0x30, target: StemMute(A, 0)),
        InputBinding(status: 0x97, data1: 0x31, target: StemMute(A, 1)),
        InputBinding(status: 0x97, data1: 0x32, target: StemMute(A, 2)),
        InputBinding(status: 0x97, data1: 0x33, target: StemMute(A, 3)),
        InputBinding(status: 0x97, data1: 0x34, target: StemSolo(A, 0)),
        InputBinding(status: 0x97, data1: 0x35, target: StemSolo(A, 1)),
        InputBinding(status: 0x97, data1: 0x36, target: StemSolo(A, 2)),
        InputBinding(status: 0x97, data1: 0x37, target: StemSolo(A, 3)),
        // Pad FX 1 mode pads 0x10..0x17 (INFERRED — standard Pioneer N×0x10 layout;
        // verify live with `ctl` harness before relying on these addresses)
        InputBinding(status: 0x97, data1: 0x10, target: BeatRepeatRoll(A, 1.0)),  // 1/4 roll (hold)
        InputBinding(status: 0x97, data1: 0x11, target: BeatRepeatRoll(A, 0.5)),  // 1/8 roll
        InputBinding(status: 0x97, data1: 0x12, target: BeatRepeatRoll(A, 0.25)), // 1/16 roll
        InputBinding(status: 0x97, data1: 0x13, target: VinylBrake(A)),           // brake (hold)
        InputBinding(status: 0x97, data1: 0x14, target: Riser(A)),                // riser (trigger)
        InputBinding(status: 0x97, data1: 0x15, target: FxSlotEnable(A, 0)),      // FX slot 1
        InputBinding(status: 0x97, data1: 0x16, target: FxSlotEnable(A, 1)),      // FX slot 2
        InputBinding(status: 0x97, data1: 0x17, target: FxSlotEnable(A, 2)),      // FX slot 3

        // ───────── Deck B (note 0x91, CC 0xB1, pads 0x99) ─────────
        InputBinding(status: 0x91, data1: 0x0B, target: Play(B)),
        InputBinding(status: 0x91, data1: 0x0C, target: CueMonitor(B)),
        // Headphone-cue (PFL) button under the channel strip (Mixxx `pfl`).
        InputBinding(status: 0x91, data1: 0x54, target: CueMonitor(B)),
        InputBinding(status: 0xB1, data1: 0x04, target: Trim(B),          hires: true),
        InputBinding(status: 0xB1, data1: 0x07, target: EqHigh(B),        hires: true),
        InputBinding(status: 0xB1, data1: 0x0B, target: EqMid(B),         hires: true),
        InputBinding(status: 0xB1, data1: 0x0F, target: EqLow(B),         hires: true),
        InputBinding(status: 0xB1, data1: 0x13, target: ChannelVolume(B), hires: true),
        InputBinding(status: 0xB1, data1: 0x00, target: Tempo(B),         hires: true),
        InputBinding(status: 0x91, data1: 0x36, target: JogTouch(B)),
        InputBinding(status: 0xB1, data1: 0x22, target: JogScratch(B),    rel: Some(Centre64)),
        InputBinding(status: 0xB1, data1: 0x21, target: JogBend(B),       rel: Some(Centre64)),
        // Loop / beat-sync cluster — notes captured live off the unit 2026-07-03.
        InputBinding(status: 0x91, data1: 0x10, target: LoopIn(B)),           // IN
        InputBinding(status: 0x91, data1: 0x11, target: LoopOut(B)),          // OUT
        InputBinding(status: 0x91, data1: 0x4D, target: LoopFourOrExit(B)),   // 4 BEAT/EXIT
        InputBinding(status: 0x91, data1: 0x51, target: LoopCallPrev(B)),     // CUE/LOOP CALL <
        InputBinding(status: 0x91, data1: 0x53, target: LoopCallNext(B)),     // CUE/LOOP CALL >
        InputBinding(status: 0x91, data1: 0x58, target: Sync(B)),             // BEAT SYNC
        InputBinding(status: 0x91, data1: 0x50, target: LoopReloop(B)),       // shift: ACTIVE
        InputBinding(status: 0x91, data1: 0x3E, target: LoopDelete(B)),       // shift: DEL
        InputBinding(status: 0x91, data1: 0x3D, target: LoopSave(B)),         // shift: MEMORY
        InputBinding(status: 0x99, data1: 0x00, target: HotCueHold(B, 0)),
        InputBinding(status: 0x99, data1: 0x01, target: HotCueHold(B, 1)),
        InputBinding(status: 0x99, data1: 0x02, target: HotCueHold(B, 2)),
        InputBinding(status: 0x99, data1: 0x03, target: HotCueHold(B, 3)),
        InputBinding(status: 0x99, data1: 0x04, target: HotCueHold(B, 4)),
        InputBinding(status: 0x99, data1: 0x05, target: HotCueHold(B, 5)),
        InputBinding(status: 0x99, data1: 0x06, target: HotCueHold(B, 6)),
        InputBinding(status: 0x99, data1: 0x07, target: HotCueHold(B, 7)),
        InputBinding(status: 0x99, data1: 0x30, target: StemMute(B, 0)),
        InputBinding(status: 0x99, data1: 0x31, target: StemMute(B, 1)),
        InputBinding(status: 0x99, data1: 0x32, target: StemMute(B, 2)),
        InputBinding(status: 0x99, data1: 0x33, target: StemMute(B, 3)),
        InputBinding(status: 0x99, data1: 0x34, target: StemSolo(B, 0)),
        InputBinding(status: 0x99, data1: 0x35, target: StemSolo(B, 1)),
        InputBinding(status: 0x99, data1: 0x36, target: StemSolo(B, 2)),
        InputBinding(status: 0x99, data1: 0x37, target: StemSolo(B, 3)),
        // Pad FX 1 mode pads 0x10..0x17 (INFERRED — standard Pioneer N×0x10 layout;
        // verify live with `ctl` harness before relying on these addresses)
        InputBinding(status: 0x99, data1: 0x10, target: BeatRepeatRoll(B, 1.0)),  // 1/4 roll (hold)
        InputBinding(status: 0x99, data1: 0x11, target: BeatRepeatRoll(B, 0.5)),  // 1/8 roll
        InputBinding(status: 0x99, data1: 0x12, target: BeatRepeatRoll(B, 0.25)), // 1/16 roll
        InputBinding(status: 0x99, data1: 0x13, target: VinylBrake(B)),           // brake (hold)
        InputBinding(status: 0x99, data1: 0x14, target: Riser(B)),                // riser (trigger)
        InputBinding(status: 0x99, data1: 0x15, target: FxSlotEnable(B, 0)),      // FX slot 1
        InputBinding(status: 0x99, data1: 0x16, target: FxSlotEnable(B, 1)),      // FX slot 2
        InputBinding(status: 0x99, data1: 0x17, target: FxSlotEnable(B, 2)),      // FX slot 3

        // ───────── shared (browser/mixer channel 6) ─────────
        InputBinding(status: 0xB6, data1: 0x1F, target: Crossfade,        hires: true),
        // MASTER LEVEL rotary — hi-res CC 0x08 (+0x28 LSB), captured live 2026-07-03.
        // (Mixxx doesn't map it; it does send MIDI. The knob is a digital encoder
        // into the app's master gain — it does NOT attenuate the master jacks.)
        InputBinding(status: 0xB6, data1: 0x08, target: Master,           hires: true),
        // HEADPHONES MIX knob — blends cued decks vs master in the phones bus.
        InputBinding(status: 0xB6, data1: 0x0C, target: CueMix,           hires: true),
        // CFX (colour FX) knobs — addresses confirmed live on hardware (ch 6)
        InputBinding(status: 0xB6, data1: 0x17, target: Filter(A),        hires: true),
        InputBinding(status: 0xB6, data1: 0x18, target: Filter(B),        hires: true),
        // library navigation: browse encoder (0xB6 0x40, relative centre-0),
        // its press (0x96 0x41) toggles the panel, load buttons (0x96 0x46/0x47).
        InputBinding(status: 0xB6, data1: 0x40, target: LibraryScroll,    rel: Some(Centre0)),
        InputBinding(status: 0x96, data1: 0x41, target: LibraryOpen),
        InputBinding(status: 0x96, data1: 0x46, target: LoadDeck(A)),
        InputBinding(status: 0x96, data1: 0x47, target: LoadDeck(B)),
    ],
    // ───────── feedback: engine state → LEDs/VU (diffed by the app) ─────────
    // VU meters follow the deck channel like everything else: left = B0 02,
    // right = B1 02 (matches Mixxx; confirmed by live ramp test 2026-07-03 —
    // the earlier "both on channel 1, right = B0 03" doc claim was wrong and
    // left the right meter dark). Play LEDs are note-on 0x7F/0x00 on the deck
    // channel; headphone-cue LEDs mirror CueMonitor on note 0x54. Requires the
    // enable SysEx (sent on connect) first.
    feedback: [
        FeedbackRule(source: DeckLevel(A),   status: 0xB0, data1: 0x02),
        FeedbackRule(source: DeckLevel(B),   status: 0xB1, data1: 0x02),
        FeedbackRule(source: DeckPlaying(A), status: 0x90, data1: 0x0B),
        FeedbackRule(source: DeckPlaying(B), status: 0x91, data1: 0x0B),
        FeedbackRule(source: DeckCued(A),    status: 0x90, data1: 0x54),
        FeedbackRule(source: DeckCued(B),    status: 0x91, data1: 0x54),
    ],
)
